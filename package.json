{
    "name": "orbit",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist-electron/main.cjs",
    "scripts": {
        "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/react-router-dom": "^5.3.3",
        "lucide-react": "^1.43.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.4",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "electron": "^44.2.0",
        "electron-builder": "^26.15.3",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.2",
        "wait-on": "^9.1.0"
    }
}
